{
  "_comment": [
    "Copy to config.json and edit. The agent creates config.json itself on first",
    "run with a generated token, mode 0600 -- so the usual path is to run it once",
    "and then edit what it wrote.",
    "",
    "Everything in 'api', 'paths', 'billing', and the price/webhook settings under",
    "'curtailment' is OPERATOR-ONLY: it can only be changed by editing this file on",
    "the farm machine. The console can change the calibration knobs and nothing",
    "else. That split is deliberate; see docs/AUDIT_v1.md, finding AUDIT-04."
  ],

  "farm_name": "Nave 1 - Teruel",
  "poll_seconds": 60,

  "api": {
    "bind_host": "127.0.0.1",
    "api_port": 8787,
    "api_token": "",
    "cors_origins": [],
    "rate_limit": {
      "window_s": 60,
      "max_attempts": 120,
      "failure_threshold": 5,
      "base_block_s": 2,
      "max_block_s": 900
    }
  },

  "miners": [
    { "name": "S19-01", "host": "192.168.1.101", "port": 4028, "type": "cgminer" },
    { "name": "S19-02", "host": "192.168.1.102", "port": 4028, "type": "cgminer" },
    { "name": "S19-03", "host": "192.168.1.103", "port": 4028, "type": "cgminer" }
  ],

  "qtmp": {
    "window": 30,
    "epsilon": 0.15,
    "z_alert": 2.5,
    "z_critical": 4.0,
    "min_siblings": 3,
    "min_samples": 10,
    "persistence": 3,
    "family_wise": true,
    "fan_temp_alert": 2.0,
    "hw_err_slope_alert": 2.0
  },

  "curtailment": {
    "enabled": true,
    "mode": "advisory",

    "hashrate_th": 100.0,
    "power_kw": 3.05,
    "hashprice_usd_th_day": 0.045,
    "eur_usd": 1.08,
    "margin": 0.05,

    "price_source": "fixed",
    "price_url": "",
    "price_headers": {},
    "fixed_price_eur_kwh": 0.12,
    "network_cost_eur_kwh": 0.04,

    "webhooks": {},
    "webhook_allowlist": []
  },

  "billing": {
    "fee_bp": 2500,
    "operator": "HashGuard",
    "payment_reference": "",
    "corroboration_margin_ppm": 1250000
  },

  "adaptive": {
    "enabled": true,
    "target_precision": 0.6,
    "step": 0.15,
    "z_min": 1.5,
    "z_max": 6.0
  },

  "paths": {
    "ledger_dir": "ledger",
    "log_dir": "logs",
    "device_key": "device_key.json",
    "state": "adaptive_state.json",
    "max_log_mb": 256
  }
}
