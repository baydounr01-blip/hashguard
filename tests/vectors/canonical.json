    },
    {
      "name": "ascii key order",
      "why": "uppercase sorts before lowercase, and '_' before lowercase letters",
      "value": {
        "b": 1,
        "A": 2,
        "a": 3,
        "_": 4,
        "B": 5,
        "-": 6,
        "0": 7
      },
      "canonical": "{\"-\":6,\"0\":7,\"A\":2,\"B\":5,\"_\":4,\"a\":3,\"b\":1}",
      "record_hash": "5f1a76a473dc9d6aa38c41f34d9a0b81e4e1c62e9b9a463d7de440ca4a016165"
    },
    {
      "name": "unicode key order",
      "why": "accented and non-latin keys sort by code point, not by locale",
      "value": {
        "é": 1,
        "e": 2,
        "z": 3,
        "ä": 4,
        "Z": 5,
        "日": 6,
        "ж": 7
      },
      "canonical": "{\"Z\":5,\"e\":2,\"z\":3,\"ä\":4,\"é\":1,\"ж\":7,\"日\":6}",
      "record_hash": "fd4a059df4b7e5f1ebbca03cfaa1d272cc666565fa7b5c4e024df7d57c5f41ca"
    },
    {
      "name": "the code-point trap",
      "why": "U+1F600 is above U+FFFF and sorts *after* U+E000 by code point, but its UTF-16 lead unit 0xD83D sorts *before* it. A JavaScript sort() that compares code units puts these two keys the other way round",
      "value": {
        "😀": "astral",
        "": "private use",
        "￿": "bmp end"
      },
      "canonical": "{\"\":\"private use\",\"￿\":\"bmp end\",\"😀\":\"astral\"}",
      "record_hash": "bef67bde50f23075c7f1da1d69b83bc54a08844c52f55937acf8ca056d1bb2d7"
    },
    {
      "name": "every json escape",
      "why": "\\b \\t \\n \\f \\r get short forms; other controls get \\u00xx",
      "value": {
        "quote": "\"",
        "backslash": "\\",
        "solidus": "/",
        "backspace": "\b",
        "formfeed": "\f",
        "newline": "\n",
        "carriage": "\r",
        "tab": "\t",
        "null byte": "\u0000",
        "unit separator": "\u001f"
      },
      "canonical": "{\"backslash\":\"\\\\\",\"backspace\":\"\\b\",\"carriage\":\"\\r\",\"formfeed\":\"\\f\",\"newline\":\"\\n\",\"null byte\":\"\\u0000\",\"quote\":\"\\\"\",\"solidus\":\"/\",\"tab\":\"\\t\",\"unit separator\":\"\\u001f\"}",
      "record_hash": "79ca7e206f850410fcc9286192aa40601383f868fb78fa54b9ca2a2893a4511e"
    },
    {
      "name": "characters that are not escaped",
      "why": "DEL, U+2028 and U+2029 are written raw by both encoders. They look like they ought to be escaped and are not, which is exactly why they are pinned",
