    },
    {
      "name": "numeric-looking keys sort as strings",
      "why": "\"10\" sorts before \"9\"; an encoder that sorts numerically disagrees",
      "value": {
        "9": 9,
        "10": 10,
        "1": 1,
        "100": 100,
        "2": 2
      },
      "canonical": "{\"1\":1,\"10\":10,\"100\":100,\"2\":2,\"9\":9}",
